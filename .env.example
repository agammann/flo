NODE_ENV=development
SHOP_API_URL=http://127.0.0.1:4101
INVENTORY_API_URL=http://127.0.0.1:4102
SUPPLIER_API_URL=http://127.0.0.1:4103
CUSTOMER_API_URL=http://127.0.0.1:4104
MCP_PORT=4100
MCP_URL=http://127.0.0.1:4100/mcp
SIMULATOR_PORT=4200
SIMULATOR_HOST=127.0.0.1
ALLOWED_ORIGIN_HOSTNAMES=127.0.0.1,localhost
FLO_AUTH_MODE=demo
FLO_DEMO_MODE=true
BEDROCK_REGION=us-west-2
BEDROCK_MODEL_ID=
BEDROCK_NARRATOR_URL=
AGENTCORE_MEMORY_ID=
AGENTCORE_RUNTIME_ARN=
AWS_PROFILE=

# Separate website customer entrypoint, disabled by default. Never expose the shop demo.
LWA_ENABLED=false
LWA_CLIENT_ID=
# Server-only runtime injection; do not paste into chat or commit a real value.
LWA_CLIENT_SECRET=
FLO_CUSTOMER_PUBLIC_ORIGIN=
FLO_CUSTOMER_LINKS_FILE=
FLO_CUSTOMER_PORT=4400
# Required for this loopback entrypoint when LWA is enabled. The TLS proxy MUST
# overwrite X-Flo-Client-IP with its socket client IP. See customer-identity.md.
FLO_CUSTOMER_TRUSTED_PROXY_ADDRESSES=
